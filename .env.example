# Stripe (test mode keys to start — https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# Stripe webhook signing secret — required to record orders + send the
# order notification email. Get this from the Stripe CLI (`stripe listen`)
# for local dev, or from the webhook endpoint's settings page in the
# Stripe Dashboard once deployed.
STRIPE_WEBHOOK_SECRET=whsec_...

# Public site URL used for Stripe success/cancel redirects in production
NEXT_PUBLIC_SITE_URL=https://kickingtee.com

# Order notification email (sent via Resend — https://resend.com — free
# tier is fine to start). Leave unset and order notifications are simply
# skipped; orders still get recorded in the local database either way.
RESEND_API_KEY=re_...
ORDER_NOTIFICATION_EMAIL=jary.max2009@gmail.com
# Must be a sender Resend has verified for your account/domain.
ORDER_NOTIFICATION_FROM=KickingTee.com <onboarding@resend.dev>

# Basic Auth for the internal /admin/orders page — pick your own values.
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASS=change-me

# Order database (https://turso.tech — free tier is fine to start). Leave
# both unset for local dev and the app falls back to a plain SQLite file
# at data/orders.db. On a serverless host (Vercel, etc.) these are
# required — the local filesystem there doesn't persist between requests.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_DATABASE_AUTH_TOKEN=...
